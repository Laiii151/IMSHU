# 世新大學校務系統帳號密碼
# SHU (Shih Hsin University) Credentials
SHU_USERNAME=your_student_id
SHU_PASSWORD=your_password

# Flask 應用程式設定
# Flask Application Settings
APP_SECRET=change-this-to-a-random-secret-key
PORT=5000

# Selenium 瀏覽器設定
# Selenium Browser Settings
# 設為 True 時使用無頭模式（伺服器環境建議設為 True）
# Set to True for headless mode (recommended for server environments)
HEADLESS=True

# Chrome 瀏覽器路徑（選填，通常會自動偵測）
# Chrome binary path (optional, usually auto-detected)
# CHROME_BIN=/usr/bin/chromium

# Google Drive 設定
# Google Drive Settings
# 目標上傳資料夾的 ID（選填，留空則上傳到根目錄）
# Target folder ID for uploads (optional, leave empty to upload to root)
# 如何取得資料夾 ID：開啟 Google Drive 資料夾，URL 中的最後一段即為資料夾 ID
# How to get folder ID: Open the folder in Google Drive, the last part of URL is the folder ID
# Example: https://drive.google.com/drive/folders/1ABC...XYZ -> GDRIVE_FOLDER_ID=1ABC...XYZ
GDRIVE_FOLDER_ID=

# 爬蟲執行逾時設定（單位：秒）
# Scraper timeout settings (in seconds)
TIMEOUT_TIMETABLE=240
TIMEOUT_GRADES=300
TIMEOUT_RANKING=300
TIMEOUT_ATTENDANCE=300

# Python 編碼設定（通常不需要修改）
# Python encoding settings (usually no need to change)
PYTHONIOENCODING=utf-8
